{
  "name": "ethr-did-registry",
  "version": "2.0.0",
  "description": "Ethereum contract for a registry of Decentralized Identifiers (DIDs) — the ERC-1056 contract anchoring did:ethr",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifacts/*": "./artifacts/*",
    "./contracts/*": "./contracts/*",
    "./typechain-types": {
      "types": "./dist/typechain-types/index.d.ts",
      "default": "./dist/typechain-types/index.js"
    },
    "./typechain-types/*": {
      "types": "./dist/typechain-types/*.d.ts",
      "default": "./dist/typechain-types/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "artifacts",
    "contracts",
    "dist",
    "typechain-types",
    "LICENSE",
    "README.md",
    "!dist/__tests__"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentralized-identity/ethr-did-resolver.git",
    "directory": "packages/ethr-did-registry"
  },
  "author": "Pelle Braendgaard",
  "contributors": [
    "Mircea Nistor <work@mirceanis.xyz>"
  ],
  "license": "MIT",
  "keywords": [
    "did:ethr",
    "DID",
    "EIP1056",
    "ERC1056",
    "ERC-1056",
    "ethereum",
    "registry",
    "smart-contract",
    "solidity"
  ],
  "scripts": {
    "build": "hardhat compile && tsc",
    "test": "hardhat test",
    "test:ci": "hardhat test --coverage",
    "deploy:registry": "hardhat run scripts/deploy.ts --network deploy",
    "clean": "rm -rf ./artifacts ./cache ./typechain-types ./dist ./lib.commonjs ./lib.esm",
    "format": "prettier --write \"contracts/**/*.sol\" \"src/**/*.[jt]s\" \"scripts/**/*.[jt]s\"",
    "lint": "solhint \"contracts/**/*.sol\" && eslint \"src/**/*.[jt]s\" \"scripts/**/*.[jt]s\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "chai": "6.2.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "ethers": "6.17.0",
    "hardhat": "3.15.0",
    "mocha": "11.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-solidity": "2.4.1",
    "solhint": "6.2.4",
    "typescript": "6.0.3"
  }
}
