{
  "name": "ethr-7702",
  "version": "1.1.0",
  "description": "EIP-7702 PoC: EOA → ERC-1056 (did:ethr) interactions enabled by Pectra hardfork",
  "type": "module",
  "scripts": {
    "build:contracts": "tsx scripts/compile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "preview:webapp": "vite preview --config webapp/vite.config.ts",
    "typecheck:webapp": "tsc -p webapp/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "0.4.0-beta.1",
    "did-resolver": "^4.1.0",
    "ethers": "^6.13.0",
    "ethr-did-resolver": "^11.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solc": "0.8.28",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "7.3.1",
    "vitest": "^3.0.0"
  }
}
