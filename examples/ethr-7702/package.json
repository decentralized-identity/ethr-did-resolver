{
  "name": "ethr-7702",
  "version": "1.1.0",
  "description": "EIP-7702 PoC: EOA → ERC-1056 (did:ethr) interactions enabled by Pectra hardfork",
  "type": "module",
  "scripts": {
    "build:contracts": "tsx scripts/compile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "preview:webapp": "vite preview --config webapp/vite.config.ts",
    "test:webapp": "vitest run --config webapp/vitest.config.ts",
    "typecheck:webapp": "tsc -p webapp/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "1.7.0",
    "did-resolver": "^5.0.1",
    "ethers": "^6.17.0",
    "ethr-did-resolver": "^14.1.0",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solc": "0.8.36",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
