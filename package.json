{
  "name": "ethr-did-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo workspace for the did:ethr ecosystem libraries",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "changeset": "changeset",
    "release:publish": "pnpm run build && changeset publish"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@changesets/cli": "2.31.1"
  }
}